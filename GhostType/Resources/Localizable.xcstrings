{
  "sourceLanguage" : "en",
  "version" : "1.0",
  "strings" : {
    "%@ snippets stored" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済み%@件"
          }
        }
      }
    },
    "1. Choose where inference runs" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 推論の実行場所を選ぶ"
          }
        }
      }
    },
    "1. Connect to your LLM server" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. LLMサーバーに接続"
          }
        }
      }
    },
    "1.00 disables it. Small models loop without it, repeating the same clause until they run out of tokens." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1.00で無効。小さいモデルはこれが無いと同じ言い回しをトークンが尽きるまで繰り返します。"
          }
        }
      }
    },
    "2. Grant permissions" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. 権限を許可"
          }
        }
      }
    },
    "3. Shortcuts" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. ショートカット"
          }
        }
      }
    },
    "A llama.cpp server unlocks the same fill-in-the-middle and grammar path the built-in backend uses. GhostType detects it automatically." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "llama.cppサーバーなら、内蔵バックエンドと同じfill-in-the-middleと文法制約の経路が使えます。GhostTypeが自動で判別します。"
          }
        }
      }
    },
    "API Key" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APIキー"
          }
        }
      }
    },
    "Accept" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受け入れ"
          }
        }
      }
    },
    "Accept completion" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補完を受け入れる"
          }
        }
      }
    },
    "Accessibility" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセシビリティ"
          }
        }
      }
    },
    "Add" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追加"
          }
        }
      }
    },
    "Add App..." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを追加..."
          }
        }
      }
    },
    "Advanced, high throughput" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "高度、高スループット"
          }
        }
      }
    },
    "All set. GhostType is ready to use in any app." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定完了。すべてのアプリでGhostTypeをお使いいただけます。"
          }
        }
      }
    },
    "Allows short multi-line completions. Better for editors and notes." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数行の補完を許可します。エディタやメモ向け。"
          }
        }
      }
    },
    "Appearance" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外観"
          }
        }
      }
    },
    "Auto-trigger completions" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補完を自動トリガー"
          }
        }
      }
    },
    "Auto-trigger paused after repeated failures. Use the manual shortcut to retry." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "連続したエラーのため自動補完を一時停止しました。手動ショートカットで再試行できます。"
          }
        }
      }
    },
    "Auto-trigger pauses while a non-ASCII IME (Japanese, Chinese, Korean, …) is active so it never fights your composition. Switch back to ABC / English to resume." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非ASCIIのIME（日本語・中国語・韓国語など）が有効な間は自動トリガーが停止し、変換と競合しません。ABC/英字入力に戻すと再開します。"
          }
        }
      }
    },
    "Auto-trigger while typing" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力中に自動で補完する"
          }
        }
      }
    },
    "Backend" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックエンド"
          }
        }
      }
    },
    "Best for email, chat, and browser fields. Blocks newlines and code fences." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メール、チャット、ブラウザの入力欄向け。改行とコードフェンスを禁止します。"
          }
        }
      }
    },
    "Built-in (llama.cpp)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "内蔵(llama.cpp)"
          }
        }
      }
    },
    "CLI, ollama serve" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CLI、ollama serve"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        }
      }
    },
    "Cannot connect. Is the server running?" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続できません。サーバーは起動していますか?"
          }
        }
      }
    },
    "Changing the language requires relaunching GhostType to take effect." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言語の変更を反映するにはGhostTypeを再起動する必要があります。"
          }
        }
      }
    },
    "Check for Updates..." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートを確認..."
          }
        }
      }
    },
    "Cloud API (your key)" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "クラウドAPI(自分のキー)"
          }
        }
      }
    },
    "Code & technical docs" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コード・技術文書向け"
