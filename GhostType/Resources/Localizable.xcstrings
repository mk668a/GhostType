    "Completion Style" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補完のスタイル"
          }
        }
      }
    },
    "Completions leave your Mac" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補完内容がMacの外に出ます"
          }
        }
      }
    },
    "Connected" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続済み"
          }
        }
      }
