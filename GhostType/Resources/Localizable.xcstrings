    "GhostType connects to an OpenAI-compatible API server.\nStart your LLM in LM Studio, Ollama, or any compatible app before using." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GhostType は OpenAI 互換 API サーバーに接続します。\n使用前に LM Studio、Ollama などの対応アプリで LLM を起動してください。"
          }
        }
      }
    },
    "GhostType Settings" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GhostType 設定"
          }
        }
      }
    },
    "GhostType will not activate at all in these apps. IDEs and terminals are excluded by default (they have their own completions)." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのアプリでは GhostType は一切動作しません。IDE やターミナルは独自の補完を持つため、既定で除外されています。"
          }
        }
      }
    },
    "Grant both permissions above to enable system-wide completions." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム全体で補完を有効にするには、上記の両方の権限を許可してください。"
