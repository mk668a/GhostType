        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "補完を自動トリガー"
          }
        }
      }
    },
    "Auto-trigger pauses while a non-ASCII IME (Japanese, Chinese, Korean, …) is active so it never fights your composition. Switch back to ABC / English to resume." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "非 ASCII の IME（日本語・中国語・韓国語など）が有効な間は自動トリガーが停止し、変換と競合しません。ABC / 英字入力に戻すと再開します。"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キャンセル"
          }
        }
      }
