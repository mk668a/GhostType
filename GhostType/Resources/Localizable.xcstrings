    "Done" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了"
          }
        }
      }
    },
    "Download" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード"
          }
        }
      }
    },
    "Download a model and GhostType runs it for you. Nothing else to install." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルをダウンロードすればGhostTypeが動かします。他に入れるものはありません。"
          }
        }
      }
    },
    "Download cancelled." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードを中止しました。"
          }
        }
      }
    },
    "Download failed with HTTP %d. Check your connection and try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードがHTTP %dで失敗しました。接続を確認してもう一度お試しください。"
          }
        }
      }
    },
    "Download was incomplete (%1$@ of %2$@). Try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードが完了しませんでした(%2$@中%1$@)。もう一度お試しください。"
          }
        }
      }
